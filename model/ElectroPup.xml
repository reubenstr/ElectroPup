    <default class="abductor">
      <joint range="-45 45"/>
    </default>
   
    <default class="hip_front">
      <joint range="-1 1"/>
    </default>
  
    <default class="hip_rear">
      <joint range="-1 1"/>
    </default>
   
    <default class="knee">
      <joint range="-1 1" axis="0 -0.0775009 0.996992"/>
